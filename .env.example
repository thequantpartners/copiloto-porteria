# ============================================================================
# CONFIGURACIÓN DEL COPILOTO DE PORTERÍA
# ============================================================================

# 1. Proveedor Primario (Google Gemini - Gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Proveedor activo por defecto: gemini | openai | openrouter | groq
LLM_PROVIDER=gemini

# 2. Proveedores Alternativos (Opcionales para Benchmark / Parte D)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 3. Fecha Canónica de Referencia de la Prueba
FECHA_ACTUAL=2026-10-16

# 4. Servidor HTTP
PORT=3000
