{
  "name": "copiloto-porteria",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Copiloto para operadores de portería remota.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
